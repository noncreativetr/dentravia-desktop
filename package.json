{
  "name": "dentravia-desktop",
  "productName": "Dentravia",
  "version": "1.6.0",
  "description": "Dentravia CRM masaüstü uygulaması",
  "author": "Dentravia",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --ia32 --publish never",
    "release:win": "electron-builder --win nsis --x64 --ia32 --publish always"
  },
  "devDependencies": {
    "electron": "43.8.7",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.dentravia.crm",
    "productName": "Dentravia",
    "artifactName": "Dentravia-Kurulum-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dentravia",
      "language": "1055"
    },
    "publish": {
      "provider": "github",
      "owner": "noncreativetr",
      "repo": "dentravia-desktop",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "vendor/rustdesk",
        "to": "rustdesk",
        "filter": [
          "*.exe",
          "LICENSE*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noncreativetr/dentravia-desktop.git"
  }
}
